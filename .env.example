# Root-level env file consumed by docker-compose.yml / docker-compose.monitoring.yml.
# Copy this to `.env` (already git-ignored) and fill in real values:
#   cp .env.example .env
#
# This is separate from backend/.env and frontend/.env.local, which remain
# used by the native (non-Docker) dev workflow (`mvn spring-boot:run` /
# `npm run dev`) - this file is specifically for Docker Compose.

# ---- PostgreSQL -------------------------------------------------------
POSTGRES_DB=intellimail
POSTGRES_USER=intellimail_app
POSTGRES_PASSWORD=change-me-to-a-real-password

# Backend connects to the `postgres` service by its Compose service name, not
# localhost - leave the host/port segment as-is, only the db name should match
# POSTGRES_DB above if you change it.
DB_URL=jdbc:postgresql://postgres:5432/intellimail
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ---- Azure OpenAI (Spring AI) -------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Leave unset/true unless your deployment rejects custom temperature/max-tokens
# (see AzureOpenAiClient's Javadoc) - set to false for reasoning-tier models.
AI_SEND_SAMPLING_PARAMETERS=true
AZURE_OPENAI_TEMPERATURE=0.7
AZURE_OPENAI_MAX_TOKENS=1024

# ---- Auth ----------------------------------------------------------------
# Generate a real one: openssl rand -base64 64
JWT_SECRET=change-this-secret-in-production-min-256-bits-long-please
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Mail (Forgot Password emails) ----------------------------------------
# Gmail SMTP with an App Password (not your regular Gmail password) - generate
# one at https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the account). Leave MAIL_USERNAME/MAIL_PASSWORD unset to disable
# password-reset email delivery (forgot-password requests still return 200,
# but no email is ever sent - see PasswordResetService's Javadoc).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME if unset.
MAIL_FROM=

# Public URL of the deployed frontend - embedded in password-reset email links
# as `${FRONTEND_URL}/reset-password?token=...`. Set to your real domain once
# deployed (e.g. https://your-domain.com); defaults to local dev otherwise.
FRONTEND_URL=http://localhost:5173

# ---- Google Sign-In (multi-tenant SaaS core) -------------------------------
# OAuth 2.0 Web Client ID from Google Cloud Console - see docs/saas-setup.md.
# Not a secret (no client secret exists in this app - ID-token verification
# never talks to Google server-to-server), but leave unset to disable the
# "Sign in with Google" button/endpoint entirely.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Stripe billing (multi-tenant SaaS core) -------------------------------
# See docs/saas-setup.md for creating the Stripe account, Products/Prices,
# and webhook endpoint. Leave unset to disable checkout/portal/webhook -
# organizations still get a 14-day trial subscription row, it just can never
# be upgraded past it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# ---- App -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
UPLOAD_MAX_FILE_SIZE=10MB

# Comma-separated. Must include your real deployed origin(s) - the default
# below only covers the Chrome extension. Once you're behind the reverse
# proxy on a real domain, add it here, e.g. https://your-domain.com
CORS_ALLOWED_ORIGINS=chrome-extension://*

# Baked into the frontend image at BUILD time (see frontend/Dockerfile) - leave
# empty for the default same-origin-behind-the-reverse-proxy setup.
VITE_API_BASE_URL=

# ---- HTTPS activation (used later by deploy/scripts/init-letsencrypt.sh) --
# DOMAIN_NAME=your-domain.com
# LETSENCRYPT_EMAIL=you@example.com

# ---- Monitoring (docker-compose.monitoring.yml, opt-in) -------------------
# Leave MANAGEMENT_SERVER_PORT unset for the base stack - actuator (including
# /actuator/health, which the backend container's own healthcheck depends on)
# stays on the main port. Only uncomment this when you're actually bringing up
# docker-compose.monitoring.yml, so Prometheus can scrape /actuator/prometheus
# on its own internal, unauthenticated-but-never-published port instead.
# MANAGEMENT_SERVER_PORT=9404
GRAFANA_ADMIN_PASSWORD=change-me

